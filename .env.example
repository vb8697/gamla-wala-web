# ==========================================
# GamlaWala 🌱 — Environment Configuration
# Brand Tagline: Har Ghar Hariyali
# ==========================================

# Application Environment
PORT=4000
API_URL=http://localhost:4000/api/v1
WEB_URL=http://localhost:3000

# PostgreSQL Database (Local Docker or Managed Postgres)
DATABASE_URL="postgresql://postgres:gamlawala_secret@localhost:5432/gamlawala?schema=public"

# Redis (Caching, Rate Limiting & Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""

# Authentication & JWT Secrets
JWT_SECRET="gamlawala-super-secure-jwt-key-har-ghar-hariyali-2026"
JWT_EXPIRES_IN="7d"
REFRESH_TOKEN_SECRET="gamlawala-refresh-secret-seed-key"

# Payment Gateway (Razorpay India)
RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="rzp_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="whsec_placeholder"

# Cloud Storage (AWS S3 or Cloudflare R2 for Plant Images)
STORAGE_BUCKET="gamlawala-assets"
STORAGE_REGION="ap-south-1"
STORAGE_ACCESS_KEY="placeholder_access_key"
STORAGE_SECRET_KEY="placeholder_secret_key"
STORAGE_PUBLIC_URL="https://cdn.gamlawala.com"

# Business & Tax Settings (India)
DEFAULT_CURRENCY=INR
GST_PERCENTAGE=18
DEFAULT_SHIPPING_FEE=99
FREE_SHIPPING_THRESHOLD=999
DELIVERY_AGGREGATOR_API_KEY=""

# Admin Default Seed Credentials
ADMIN_EMAIL="admin@gamlawala.com"
ADMIN_PASSWORD="GamlaWalaAdmin@2026"
